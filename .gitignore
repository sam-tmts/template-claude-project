# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Editor state. .vscode/ is deliberately NOT ignored: a file such as
# .vscode/tasks.json can run commands on the host, so any change to it must show up in
# git status and in review. Shared editor settings belong in devcontainer.json.
.idea/
*.swp

# Secrets and credentials: these must never be committed (see ADR-0004)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Claude Code personal overrides (shared settings live in .claude/settings.json)
.claude/settings.local.json

# Logs and scratch files
*.log
*.tmp
tmp/

# Language-specific entries are added by each project's CR-0001
