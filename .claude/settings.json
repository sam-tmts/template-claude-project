{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Edit(/.git/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * --delete *)",
      "Bash(git commit --amend*)",
      "Bash(git commit * --amend*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n *)",
      "Bash(git commit * -n)",
      "Bash(git -c *)",
      "Bash(git config *hooksPath*)",
      "Bash(git config *fsmonitor*)",
      "Bash(git rebase *)",
      "Bash(git reset --hard*)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git branch --delete *)",
      "Bash(gh pr merge*)",
      "Bash(git -C *)",
      "Bash(git push * +*)",
      "Bash(git push +*)"
    ],
    "ask": [
      "Edit(/.devcontainer/**)",
      "Edit(/.claude/**)",
      "Edit(/.githooks/**)",
      "Edit(/.github/**)",
      "Edit(/.vscode/**)",
      "Edit(/SECURITY.md)",
      "Bash(git push *)",
      "Bash(gh *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(bash -c *)",
      "Bash(sh -c *)",
      "Bash(env *)"
    ],
    "disableBypassPermissionsMode": "disable"
  }
}
